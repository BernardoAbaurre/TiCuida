# Copie para .env e ajuste os valores (o .env não vai para o git).

# Chaves secretas: em produção use valores longos e aleatórios
# (ex.: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-esta-chave-secreta-em-producao-0123456789
JWT_SECRET_KEY=troque-esta-chave-jwt-em-producao-0123456789abcdef
JWT_EXPIRA_HORAS=8

# Banco de dados: SQLite em desenvolvimento (arquivo em instance/ticuida.db).
# Em produção, PostgreSQL: postgresql+psycopg://usuario:senha@host:5432/ticuida
DATABASE_URL=sqlite:///ticuida.db

# Origens liberadas no CORS (front-end Vite em desenvolvimento)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logs
LOG_LEVEL=INFO
LOG_DIR=logs

# Fuso usado para saber se a unidade está aberta agora
FUSO_HORARIO=America/Sao_Paulo

# Senha das contas de demonstração criadas por "flask seed"
SEED_SENHA=Ticuida@2026
