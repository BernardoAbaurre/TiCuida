  encaminhamentos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F3A68"><TR><TD COLSPAN="3" BGCOLOR="#1F3A68" ALIGN="CENTER"><FONT COLOR="white"><B>encaminhamentos</B></FONT></TD></TR><TR><TD PORT="id_l" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B8860B"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><B>id</B></TD><TD PORT="id_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">integer </FONT></TD></TR><TR><TD PORT="triagem_id_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#2E5C99"><B>FK</B></FONT> UQ</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">triagem_id</TD><TD PORT="triagem_id_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">integer NN</FONT></TD></TR><TR><TD PORT="unidade_id_l" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#2E5C99"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">unidade_id</TD><TD PORT="unidade_id_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">integer NN</FONT></TD></TR><TR><TD PORT="protocolo_l" ALIGN="LEFT" BGCOLOR="#EEF3FA">UQ</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">protocolo</TD><TD PORT="protocolo_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">char(8) NN</FONT></TD></TR><TR><TD PORT="status_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">status</TD><TD PORT="status_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">varchar(15) NN</FONT></TD></TR><TR><TD PORT="criado_em_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">criado_em</TD><TD PORT="criado_em_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">timestamptz NN</FONT></TD></TR><TR><TD PORT="atualizado_em_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">atualizado_em</TD><TD PORT="atualizado_em_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">timestamptz NN</FONT></TD></TR></TABLE>>];
  usuarios:unidade_id_r:e -> unidades:id_l:w [arrowtail=crowodot, arrowhead=teeodot];
