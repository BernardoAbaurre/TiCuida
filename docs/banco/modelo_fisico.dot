digraph ticuida {
  graph [rankdir=LR, splines=spline, nodesep=0.5, ranksep=1.1, pad=0.4, bgcolor="white", fontname="Arial", label=<<B>TiCuida — Modelo físico (PostgreSQL 16)</B><BR/><FONT POINT-SIZE="10">PK = chave primária · FK = chave estrangeira · UQ = único · NN = não nulo</FONT>>, labelloc=t, fontsize=18];
  node [shape=plain, fontname="Arial", fontsize=10];
  edge [color="#5A6F8C", penwidth=1.1, dir=both, arrowsize=0.9];
  usuarios [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F3A68"><TR><TD COLSPAN="3" BGCOLOR="#1F3A68" ALIGN="CENTER"><FONT COLOR="white"><B>usuarios</B></FONT></TD></TR><TR><TD PORT="id_l" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B8860B"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><B>id</B></TD><TD PORT="id_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">integer </FONT></TD></TR><TR><TD PORT="email_l" ALIGN="LEFT" BGCOLOR="#EEF3FA">UQ</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">email</TD><TD PORT="email_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD PORT="senha_hash_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">senha_hash</TD><TD PORT="senha_hash_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD PORT="papel_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">papel</TD><TD PORT="papel_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">varchar(10) NN</FONT></TD></TR><TR><TD PORT="unidade_id_l" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#2E5C99"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">unidade_id</TD><TD PORT="unidade_id_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">integer </FONT></TD></TR><TR><TD PORT="ativo_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">ativo</TD><TD PORT="ativo_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">boolean NN</FONT></TD></TR><TR><TD PORT="criado_em_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">criado_em</TD><TD PORT="criado_em_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">timestamptz NN</FONT></TD></TR><TR><TD PORT="atualizado_em_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">atualizado_em</TD><TD PORT="atualizado_em_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">timestamptz NN</FONT></TD></TR></TABLE>>];
  pacientes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F3A68"><TR><TD COLSPAN="3" BGCOLOR="#1F3A68" ALIGN="CENTER"><FONT COLOR="white"><B>pacientes</B></FONT></TD></TR><TR><TD PORT="id_l" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B8860B"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><B>id</B></TD><TD PORT="id_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">integer </FONT></TD></TR><TR><TD PORT="usuario_id_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#2E5C99"><B>FK</B></FONT> UQ</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">usuario_id</TD><TD PORT="usuario_id_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">integer NN</FONT></TD></TR><TR><TD PORT="nome_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">nome</TD><TD PORT="nome_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">varchar(150) NN</FONT></TD></TR><TR><TD PORT="cpf_l" ALIGN="LEFT" BGCOLOR="#EEF3FA">UQ</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">cpf</TD><TD PORT="cpf_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">char(11) NN</FONT></TD></TR><TR><TD PORT="data_nascimento_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">data_nascimento</TD><TD PORT="data_nascimento_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">date NN</FONT></TD></TR><TR><TD PORT="telefone_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">telefone</TD><TD PORT="telefone_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">varchar(20) NN</FONT></TD></TR><TR><TD PORT="contato_emergencia_nome_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">contato_emergencia_nome</TD><TD PORT="contato_emergencia_nome_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">varchar(150) NN</FONT></TD></TR><TR><TD PORT="contato_emergencia_telefone_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">contato_emergencia_telefone</TD><TD PORT="contato_emergencia_telefone_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">varchar(20) NN</FONT></TD></TR><TR><TD PORT="convenio_id_l" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#2E5C99"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">convenio_id</TD><TD PORT="convenio_id_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">integer NN</FONT></TD></TR><TR><TD PORT="numero_carteirinha_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">numero_carteirinha</TD><TD PORT="numero_carteirinha_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">varchar(30) </FONT></TD></TR><TR><TD PORT="consentimento_em_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">consentimento_em</TD><TD PORT="consentimento_em_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">timestamptz NN</FONT></TD></TR><TR><TD PORT="criado_em_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">criado_em</TD><TD PORT="criado_em_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">timestamptz NN</FONT></TD></TR><TR><TD PORT="atualizado_em_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">atualizado_em</TD><TD PORT="atualizado_em_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">timestamptz NN</FONT></TD></TR></TABLE>>];
  convenios [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F3A68"><TR><TD COLSPAN="3" BGCOLOR="#1F3A68" ALIGN="CENTER"><FONT COLOR="white"><B>convenios</B></FONT></TD></TR><TR><TD PORT="id_l" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B8860B"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><B>id</B></TD><TD PORT="id_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">integer </FONT></TD></TR><TR><TD PORT="nome_l" ALIGN="LEFT" BGCOLOR="#EEF3FA">UQ</TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">nome</TD><TD PORT="nome_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">varchar(100) NN</FONT></TD></TR><TR><TD PORT="ativo_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">ativo</TD><TD PORT="ativo_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">boolean NN</FONT></TD></TR></TABLE>>];
  unidade_convenio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F3A68"><TR><TD COLSPAN="3" BGCOLOR="#1F3A68" ALIGN="CENTER"><FONT COLOR="white"><B>unidade_convenio</B></FONT></TD></TR><TR><TD PORT="unidade_id_l" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B8860B"><B>PK</B></FONT> <FONT COLOR="#2E5C99"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><B>unidade_id</B></TD><TD PORT="unidade_id_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">integer </FONT></TD></TR><TR><TD PORT="convenio_id_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#B8860B"><B>PK</B></FONT> <FONT COLOR="#2E5C99"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>convenio_id</B></TD><TD PORT="convenio_id_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">integer </FONT></TD></TR></TABLE>>];
  unidades [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F3A68"><TR><TD COLSPAN="3" BGCOLOR="#1F3A68" ALIGN="CENTER"><FONT COLOR="white"><B>unidades</B></FONT></TD></TR><TR><TD PORT="id_l" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B8860B"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><B>id</B></TD><TD PORT="id_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">integer </FONT></TD></TR><TR><TD PORT="nome_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">nome</TD><TD PORT="nome_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">varchar(150) NN</FONT></TD></TR><TR><TD PORT="tipo_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">tipo</TD><TD PORT="tipo_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">varchar(20) NN</FONT></TD></TR><TR><TD PORT="telefone_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">telefone</TD><TD PORT="telefone_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">varchar(20) </FONT></TD></TR><TR><TD PORT="logradouro_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">logradouro</TD><TD PORT="logradouro_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">varchar(150) NN</FONT></TD></TR><TR><TD PORT="numero_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">numero</TD><TD PORT="numero_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">varchar(10) NN</FONT></TD></TR><TR><TD PORT="bairro_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">bairro</TD><TD PORT="bairro_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">varchar(80) NN</FONT></TD></TR><TR><TD PORT="cidade_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">cidade</TD><TD PORT="cidade_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">varchar(80) NN</FONT></TD></TR><TR><TD PORT="uf_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">uf</TD><TD PORT="uf_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">char(2) NN</FONT></TD></TR><TR><TD PORT="cep_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">cep</TD><TD PORT="cep_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">char(8) </FONT></TD></TR><TR><TD PORT="latitude_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">latitude</TD><TD PORT="latitude_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">numeric(9,6) NN</FONT></TD></TR><TR><TD PORT="longitude_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">longitude</TD><TD PORT="longitude_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">numeric(9,6) NN</FONT></TD></TR><TR><TD PORT="aberto_24h_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">aberto_24h</TD><TD PORT="aberto_24h_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">boolean NN</FONT></TD></TR><TR><TD PORT="horario_abertura_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">horario_abertura</TD><TD PORT="horario_abertura_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">time </FONT></TD></TR><TR><TD PORT="horario_fechamento_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">horario_fechamento</TD><TD PORT="horario_fechamento_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">time </FONT></TD></TR><TR><TD PORT="ativo_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">ativo</TD><TD PORT="ativo_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">boolean NN</FONT></TD></TR><TR><TD PORT="criado_em_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">criado_em</TD><TD PORT="criado_em_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">timestamptz NN</FONT></TD></TR></TABLE>>];
  registros_lotacao [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F3A68"><TR><TD COLSPAN="3" BGCOLOR="#1F3A68" ALIGN="CENTER"><FONT COLOR="white"><B>registros_lotacao</B></FONT></TD></TR><TR><TD PORT="id_l" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B8860B"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><B>id</B></TD><TD PORT="id_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">integer </FONT></TD></TR><TR><TD PORT="unidade_id_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#2E5C99"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">unidade_id</TD><TD PORT="unidade_id_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">integer NN</FONT></TD></TR><TR><TD PORT="operador_id_l" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#2E5C99"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">operador_id</TD><TD PORT="operador_id_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">integer NN</FONT></TD></TR><TR><TD PORT="nivel_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">nivel</TD><TD PORT="nivel_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">varchar(5) NN</FONT></TD></TR><TR><TD PORT="registrado_em_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">registrado_em</TD><TD PORT="registrado_em_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">timestamptz NN</FONT></TD></TR></TABLE>>];
  triagens [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F3A68"><TR><TD COLSPAN="3" BGCOLOR="#1F3A68" ALIGN="CENTER"><FONT COLOR="white"><B>triagens</B></FONT></TD></TR><TR><TD PORT="id_l" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B8860B"><B>PK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><B>id</B></TD><TD PORT="id_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">integer </FONT></TD></TR><TR><TD PORT="paciente_id_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#2E5C99"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">paciente_id</TD><TD PORT="paciente_id_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">integer NN</FONT></TD></TR><TR><TD PORT="queixa_principal_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">queixa_principal</TD><TD PORT="queixa_principal_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">varchar(500) NN</FONT></TD></TR><TR><TD PORT="intensidade_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">intensidade</TD><TD PORT="intensidade_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">smallint NN</FONT></TD></TR><TR><TD PORT="inicio_sintomas_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">inicio_sintomas</TD><TD PORT="inicio_sintomas_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">varchar(15) NN</FONT></TD></TR><TR><TD PORT="temperatura_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">temperatura</TD><TD PORT="temperatura_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">numeric(3,1) </FONT></TD></TR><TR><TD PORT="prioridade_l" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">prioridade</TD><TD PORT="prioridade_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">varchar(15) NN</FONT></TD></TR><TR><TD PORT="criada_em_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"> </TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA">criada_em</TD><TD PORT="criada_em_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">timestamptz NN</FONT></TD></TR></TABLE>>];
  triagem_sintoma [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F3A68"><TR><TD COLSPAN="3" BGCOLOR="#1F3A68" ALIGN="CENTER"><FONT COLOR="white"><B>triagem_sintoma</B></FONT></TD></TR><TR><TD PORT="triagem_id_l" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B8860B"><B>PK</B></FONT> <FONT COLOR="#2E5C99"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><B>triagem_id</B></TD><TD PORT="triagem_id_r" ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#555555">integer </FONT></TD></TR><TR><TD PORT="sintoma_id_l" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#B8860B"><B>PK</B></FONT> <FONT COLOR="#2E5C99"><B>FK</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF3FA"><B>sintoma_id</B></TD><TD PORT="sintoma_id_r" ALIGN="LEFT" BGCOLOR="#EEF3FA"><FONT COLOR="#555555">integer </FONT></TD></TR></TABLE>>];
